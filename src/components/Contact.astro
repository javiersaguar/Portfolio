---
import Icon from './Icon.astro';
import { certifications, featured, sideQuests, site, stack } from '../data/site';

const channels = [
  { name: 'GitHub', handle: `@${site.handle}`, href: site.github, icon: 'github' as const },
  { name: 'LinkedIn', handle: site.linkedinHandle, href: site.linkedin, icon: 'linkedin' as const },
  { name: 'Email', handle: site.email, href: `mailto:${site.email}`, icon: 'mail' as const },
];

const termData = {
  name: site.name,
  github: site.github,
  linkedin: site.linkedin,
  email: site.email,
  projects: featured.map((p) => ({ name: p.name, tagline: p.tagline })),
  quests: sideQuests.map((q) => ({ name: q.name, note: q.note })),
  stack: stack.map((g) => ({ group: g.group, items: g.items.map((i) => i.name) })),
  certs: certifications.map((c) => `${c.name} (${c.issuer})`),
};
---

<section class="section" id="contact">
  <div class="wrap">
    <h2 class="section-title reveal">Contact</h2>
    <p class="section-lead reveal">Looking for internships and junior roles in data engineering. Say hi.</p>

    <ul class="channels">
      {
        channels.map((c, i) => (
          <li class="reveal" style={`--d:${i}`}>
            <a href={c.href} target={c.icon === 'mail' ? undefined : '_blank'} rel="noopener">
              <Icon name={c.icon} class="c-icon" />
              <span class="c-name pixel">{c.name}</span>
              <span class="c-handle mono">{c.handle}</span>
              {c.icon !== 'mail' && <Icon name="arrow" class="c-arrow" />}
            </a>
            {c.icon === 'mail' && (
              <button type="button" class="copy" data-copy={site.email} aria-label="Copy email address">
                <Icon name="copy" />
              </button>
            )}
          </li>
        ))
      }
    </ul>

    <div class="term reveal" data-term={JSON.stringify(termData)}>
      <div class="term-bar mono">
        <Icon name="terminal" />
        <span>guest@{site.domain}</span>
      </div>
      <div class="term-out mono" aria-live="polite">
        <p>hi. this is javier's terminal.</p>
        <p>type a command and press enter, or use the buttons below.</p>
      </div>
      <form class="term-in mono">
        <label for="term-cmd"><span class="prompt">guest</span>~ $</label>
        <input id="term-cmd" autocomplete="off" spellcheck="false" placeholder="type a command" aria-label="Terminal command" />
      </form>
      <div class="term-btns">
        {['help', 'whoami', 'projects', 'stack', 'achievements'].map((c) => (
          <button type="button" class="mono" data-cmd={c}>{c}</button>
        ))}
      </div>
    </div>
  </div>
</section>

<footer class="foot">
  <div class="wrap foot-inner mono">
    <span>Built block by block in Madrid. © {new Date().getFullYear()} {site.name}</span>
    <span class="foot-links">
      <button type="button" class="gb-toggle mono" aria-pressed="false">Game Boy mode</button>
      <a href="#top">Back to top</a>
    </span>
  </div>
</footer>

<style>
  .channels {
    list-style: none;
    padding: 0;
    margin: 0 0 56px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .channels li {
    position: relative;
  }
  .channels a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: auto auto;
    column-gap: 16px;
    align-items: center;
    padding: 22px 24px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: transform 200ms var(--ease), box-shadow 200ms var(--ease), border-color 200ms var(--ease);
  }
  .channels a:hover {
    border-color: var(--accent-dim);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--accent-dim);
  }
  .channels :global(.c-icon) {
    grid-row: span 2;
    width: 32px;
    height: 32px;
    color: var(--accent);
  }
  .c-name {
    font-size: 18px;
  }
  .c-handle {
    grid-column: 2;
    font-size: 13px;
    color: var(--muted);
  }
  .channels :global(.c-arrow) {
    grid-column: 3;
    grid-row: 1 / span 2;
    color: var(--muted);
    transition: transform 160ms var(--ease), color 160ms var(--ease);
  }
  .channels a:hover :global(.c-arrow) {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .c-handle {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .copy {
    position: absolute;
    top: 50%;
    right: 18px;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--line);
    cursor: pointer;
    transition: color 160ms var(--ease), border-color 160ms var(--ease);
  }
  .copy:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
  .copy.done {
    color: var(--accent);
  }

  .term {
    border: 1px solid var(--line);
    background: #090a08;
    font-size: 14px;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
  }
  .term-out {
    padding: 16px 16px 0;
    max-height: 320px;
    overflow-y: auto;
  }
  .term-out :global(p) {
    margin: 0 0 4px;
    color: var(--ink-2);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .term-out :global(.echo) {
    color: var(--muted);
  }
  .term-out :global(.ok) {
    color: var(--accent);
  }
  .term-out :global(a) {
    color: var(--accent);
  }
  .term-in {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
  }
  .term-in label {
    color: var(--muted);
    white-space: nowrap;
  }
  .prompt {
    color: var(--accent);
  }
  .term-in input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--ink);
    font: inherit;
    caret-color: var(--accent);
  }
  .term-in input::placeholder {
    color: #6f746a;
  }
  .term-in input:focus {
    outline: none;
  }
  .term-in:focus-within {
    box-shadow: inset 0 0 0 1px var(--accent-dim);
  }
  .term-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 16px 16px;
  }
  .term-btns button {
    background: var(--bg-2);
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 13px;
    padding: 6px 12px;
    cursor: pointer;
    transition: color 160ms var(--ease), border-color 160ms var(--ease), transform 100ms var(--ease);
  }
  .term-btns button:hover {
    color: var(--accent);
    border-color: var(--accent-dim);
  }
  .term-btns button:active {
    transform: translateY(1px);
  }

  .foot {
    border-top: 1px solid var(--line);
    padding: 28px 0;
  }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 13px;
    color: var(--muted);
  }
  .foot a {
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--accent);
  }
  .foot-links {
    display: flex;
    gap: 24px;
  }
  .gb-toggle {
    padding: 0;
    font-size: 13px;
    color: var(--muted);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .gb-toggle:hover,
  .gb-toggle[aria-pressed='true'] {
    color: var(--accent);
  }

  @media (max-width: 1023px) {
    .channels {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { achievements, isGameBoy, toast, toggleGameBoy, unlock, unlocked } from '../scripts/game';

  type Data = {
    name: string;
    github: string;
    linkedin: string;
    email: string;
    projects: { name: string; tagline: string }[];
    quests: { name: string; note: string }[];
    stack: { group: string; items: string[] }[];
    certs: string[];
  };

  async function copy(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  // Copy button on the email card.
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) =>
    b.addEventListener('click', async () => {
      if (await copy(b.dataset.copy!)) {
        toast('Copied', b.dataset.copy!);
        b.classList.add('done');
        setTimeout(() => b.classList.remove('done'), 1500);
      }
    }),
  );

  // Game Boy switch in the footer, kept in sync with the Konami code.
  const gb = document.querySelector<HTMLButtonElement>('.gb-toggle')!;
  const syncGb = () => gb.setAttribute('aria-pressed', String(isGameBoy()));
  syncGb();
  document.addEventListener('palette', syncGb);
  gb.addEventListener('click', () => {
    toast('Palette', toggleGameBoy() ? 'Game Boy mode on' : 'Game Boy mode off');
  });

  const term = document.querySelector<HTMLElement>('.term')!;
  const data: Data = JSON.parse(term.dataset.term!);
  const out = term.querySelector<HTMLElement>('.term-out')!;
  const form = term.querySelector<HTMLFormElement>('.term-in')!;
  const input = form.querySelector<HTMLInputElement>('input')!;
  const history: string[] = [];
  let cursor = 0;

  const print = (text: string, cls = '') => {
    const p = document.createElement('p');
    if (cls) p.className = cls;
    p.textContent = text;
    out.appendChild(p);
  };
  const link = (label: string, href: string) => {
    const p = document.createElement('p');
    const a = document.createElement('a');
    a.href = href;
    if (!href.startsWith('mailto:')) {
      a.target = '_blank';
      a.rel = 'noopener';
    }
    a.textContent = label;
    p.append(a);
    out.appendChild(p);
  };

  const commands: Record<string, () => void> = {
    help: () =>
      print(
        [
          'available commands:',
          '  whoami        who is this',
          '  projects      what I have built',
          '  quests        small things for game nights',
          '  stack         the tools I use',
          '  certs         certifications',
          '  contact       where to find me',
          '  email         copy my email address',
          '  achievements  what you have unlocked here',
          '  snake         play snake on my contribution calendar',
          '  gameboy       switch the palette',
          '  github        open my GitHub',
          '  linkedin      open my LinkedIn',
          '  clear         clean the screen',
        ].join('\n'),
      ),
    whoami: () =>
      print(`${data.name}. final-year data engineering student. big data projects, cybersecurity audits, apps, tools and games.`),
    projects: () => {
      data.projects.forEach((p) => print(`> ${p.name.padEnd(22)} ${p.tagline}`));
      print('scroll up to #projects for the details.', 'echo');
    },
    quests: () => data.quests.forEach((q) => print(`> ${q.name.padEnd(14)} ${q.note}`)),
    stack: () => data.stack.forEach((g) => print(`${(g.group.toLowerCase() + ':').padEnd(13)} ${g.items.join(', ').toLowerCase()}`)),
    certs: () => data.certs.forEach((c) => print(`* ${c}`)),
    contact: () => {
      link(`github    ${data.github}`, data.github);
      link(`linkedin  ${data.linkedin}`, data.linkedin);
      link(`email     ${data.email}`, `mailto:${data.email}`);
    },
    email: () => {
      copy(data.email).then((ok) => print(ok ? `copied ${data.email} to the clipboard.` : data.email, ok ? 'ok' : ''));
    },
    achievements: () => {
      const have = unlocked();
      const ids = Object.keys(achievements) as (keyof typeof achievements)[];
      ids.forEach((id) => print(`${have.has(id) ? '[x]' : '[ ]'} ${achievements[id].title.padEnd(16)} ${achievements[id].hint}`));
      print(`${have.size}/${ids.length} unlocked.`, 'echo');
    },
    snake: () => {
      print('loading snake...', 'ok');
      document.getElementById('activity')?.scrollIntoView({ behavior: 'smooth' });
      setTimeout(() => document.querySelector<HTMLButtonElement>('#activity .play-btn')?.click(), 600);
    },
    gameboy: () => print(toggleGameBoy() ? 'game boy mode on.' : 'game boy mode off.', 'ok'),
    github: () => {
      print('opening github...', 'ok');
      window.open(data.github, '_blank', 'noopener');
    },
    linkedin: () => {
      print('opening linkedin...', 'ok');
      window.open(data.linkedin, '_blank', 'noopener');
    },
    clear: () => {
      out.replaceChildren();
    },
    sudo: () => print('nice try. this incident will be reported.', 'ok'),
    ls: () => print('projects/  quests/  about.txt  contact.txt  pokemon-spain.sav'),
  };

  const run = (raw: string) => {
    const cmd = raw.trim().toLowerCase();
    if (!cmd) return;
    history.push(cmd);
    cursor = history.length;
    print(`guest~ $ ${cmd}`, 'echo');
    const name = cmd.split(/\s+/)[0];
    const fn = commands[name];
    if (fn) fn();
    else print(`command not found: ${name}. try "help".`);
    out.scrollTop = out.scrollHeight;
    unlock('root');
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    run(input.value);
    input.value = '';
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp' && cursor > 0) {
      input.value = history[--cursor];
      e.preventDefault();
    } else if (e.key === 'ArrowDown') {
      cursor = Math.min(cursor + 1, history.length);
      input.value = history[cursor] ?? '';
      e.preventDefault();
    } else if (e.key === 'Tab') {
      // Complete the command name.
      const match = Object.keys(commands).filter((c) => c.startsWith(input.value.trim().toLowerCase()));
      if (input.value && match.length === 1) {
        input.value = match[0];
        e.preventDefault();
      }
    }
  });
  term.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) =>
    b.addEventListener('click', () => run(b.dataset.cmd!)),
  );
</script>
