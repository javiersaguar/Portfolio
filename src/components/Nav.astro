---
import Icon from './Icon.astro';
import Controls from './Controls.astro';
import { arcadeCopy, pageLocale } from '../data/arcade-copy';
const locale = pageLocale(Astro.url);
const copy = arcadeCopy(locale);
const labels = {
  en: { back: 'Back to arcade menu', current: 'Current section', profile: 'Profile', activity: 'GitHub activity' },
  es: { back: 'Volver al menú arcade', current: 'Apartado actual', profile: 'Perfil', activity: 'Actividad GitHub' },
  zh: { back: '返回街机菜单', current: '当前栏目', profile: '个人资料', activity: 'GitHub 动态' },
}[locale];
const sections = Object.fromEntries([
  ...copy.destinations.map(destination => [destination.id, destination.label]),
  ['top', labels.profile],
  ['activity', labels.activity],
]);
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="#arcade" data-open-arcade class="brand pixel" aria-label={copy.home}>
      <span class="brand-mark" aria-hidden="true">JS</span><span class="brand-name">Javier Saguar</span>
    </a>
    <p class="current-section pixel">
      <span class="sr-only">{labels.current}: </span>
      <span data-current-section data-section-labels={JSON.stringify(sections)}>{labels.profile}</span>
    </p>
    <a href="#arcade" data-open-arcade class="back-menu" aria-label={labels.back}>
      <Icon name="gamepad" /><span class="mono">{labels.back}</span>
    </a>
    <div class="preferences"><Controls /></div>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .nav-inner { min-height: 72px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: 24px; max-width: 1440px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; font-size: 12px; }
  .brand-mark { display: grid; place-items: center; width: 32px; height: 32px; flex-shrink: 0; color: var(--accent-ink); background: var(--accent); box-shadow: 3px 3px 0 var(--accent-dim); font-size: 12px; }
  .brand-name { white-space: nowrap; }
  .current-section { margin: 0; color: var(--ink-2); text-align: center; font-size: 12px; line-height: 1.4; }
  .back-menu { display: inline-flex; justify-content: center; align-items: center; gap: 8px; min-height: 44px; padding: 10px 14px; border: 1px solid var(--accent-dim); background: var(--bg-2); color: var(--accent); text-decoration: none; font-size: 12px; line-height: 1.3; white-space: nowrap; transition: border-color 160ms ease, background-color 160ms ease; }
  .back-menu :global(.icon) { width: 19px; height: 19px; flex-shrink: 0; }
  .preferences { justify-self: end; }
  @media (hover: hover) and (pointer: fine) { .back-menu:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 9%, var(--bg-2)); } }
  @media (max-width: 1023px) { .brand-name { display: none; } .nav-inner { gap: 16px; } }
  @media (max-width: 767px) {
    .nav-inner { grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: 40px auto; grid-template-areas: 'brand preferences' 'back current'; min-height: 116px; gap: 8px 12px; padding-top: 10px; padding-bottom: 10px; }
    .brand { grid-area: brand; }
    .brand-name { display: inline; font-size: 10px; }
    .current-section { grid-area: current; text-align: right; font-size: 10px; max-width: 150px; justify-self: end; }
    .back-menu { grid-area: back; justify-self: start; padding: 9px 11px; font-size: 11px; }
    .preferences { grid-area: preferences; }
  }
  @media (max-width: 359px) { .brand-name { display: none; } .back-menu { padding: 9px 8px; font-size: 10px; gap: 5px; } .current-section { font-size: 9px; } }
</style>

<script>
  const current = document.querySelector<HTMLElement>('[data-current-section]')!;
  const labels = JSON.parse(current.dataset.sectionLabels!) as Record<string, string>;
  const updateLabel = () => {
    current.textContent = labels[document.documentElement.dataset.section || 'top'] || labels.top;
  };
  updateLabel();
  document.addEventListener('portfolio-section', updateLabel);
  addEventListener('pageshow', updateLabel);
</script>
