---
import { arcadeCopy, pageLocale } from '../data/arcade-copy';
const locale = pageLocale(Astro.url);
const copy = arcadeCopy(locale);
const label = { en: 'Next section', es: 'Siguiente apartado', zh: '下一栏目' }[locale];
const back = { en: 'Back to arcade menu', es: 'Volver al menú arcade', zh: '返回街机菜单' }[locale];
---
<div class="next-section wrap">
  <a href="#arcade" class="btn dock-back" data-open-arcade>{back}</a>
  <a href="#about" class="btn" data-next-section data-label={label} data-destinations={JSON.stringify(copy.destinations)}><span class="next-copy"><span class="next-label">{label}</span><span data-next-name></span></span><span aria-hidden="true">→</span></a>
</div>
<div class="section-laser" data-section-laser aria-hidden="true"></div>
<style>
  .next-section { position: fixed; bottom: max(16px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); z-index: 20; display: flex; justify-content: space-between; gap: 16px; width: calc(100% - 32px); max-width: 1120px; padding: 14px; background: var(--bg); border: 2px solid var(--accent-dim); box-shadow: 5px 5px 0 var(--accent-dim); }
  :global(:root[data-portfolio-mode='full']) [data-next-section] { display: none; }
  .next-section a { white-space: normal; text-align: center; font-size: 12px; min-height: 48px; align-items: center; justify-content: center; }
  .dock-back { background: var(--bg-2); color: var(--accent); border-color: var(--accent); }
  .next-copy { display: flex; flex-direction: column; gap: 4px; align-items: center; }
  .next-label { font-size: 10px; }
  [data-next-name] { font-size: 12px; }
  @media (max-width: 600px) { .next-section { gap: 10px; bottom: max(10px, env(safe-area-inset-bottom)); padding: 10px; } .next-section a { flex: 1; font-size: 10px; padding: 10px 8px; } }
  .section-laser { position: fixed; inset: 0; z-index: 30; pointer-events: none; overflow: hidden; }
</style>
<script>
  import { laserNavigate } from '../scripts/navigation-laser';
  const button = document.querySelector<HTMLAnchorElement>('[data-next-section]')!;
  const name = button.querySelector<HTMLElement>('[data-next-name]')!;
  const destinations = JSON.parse(button.dataset.destinations!) as {id:string;label:string}[];
  const update = () => {
    const index = destinations.findIndex(destination => destination.id === document.documentElement.dataset.section);
    const next = destinations[(index + 1) % destinations.length];
    button.href = `#${next.id}`;
    name.textContent = next.label;
  };
  update();
  document.addEventListener('portfolio-section', update);
  button.addEventListener('click', event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    const destination = button.hash;
    laserNavigate(button, () => { location.hash = destination; });
  });
</script>
