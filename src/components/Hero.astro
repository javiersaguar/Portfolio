---
import Icon from './Icon.astro';
import { site, skillBars, typedLines } from '../data/site';

const words = site.name.split(' ').map((w, wi, all) => {
  const offset = all.slice(0, wi).join('').length + wi;
  return [...w].map((ch, i) => ({ ch, i: offset + i }));
});

const PIPS = 20;
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="player pixel">Player 1 · Data Engineer</p>
      <h1 class="name pixel" aria-label={site.name}>
        {
          words.map((word) => (
            <span class="word" aria-hidden="true">
              {word.map(({ ch, i }) => (
                <span class="block" style={`--i:${i}`}>{ch}</span>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="sub">
        Final-year <strong>Data Engineering</strong> student at {site.school}, Madrid.
      </p>
      <p class="typed pixel" data-lines={JSON.stringify(typedLines)}>
        <span class="prompt" aria-hidden="true">&gt;</span>
        <span class="typed-text" aria-hidden="true">{typedLines[0]}</span><span class="caret" aria-hidden="true"
        ></span>
        <span class="sr-only">{typedLines.join('. ')}.</span>
      </p>
      <div class="ctas">
        <a href="#projects" class="btn">See projects <Icon name="down" /></a>
        <a href={site.linkedin} target="_blank" rel="noopener" class="btn ghost"><Icon name="linkedin" /> LinkedIn</a>
        <a href={`mailto:${site.email}`} class="btn ghost"><Icon name="mail" /> Email</a>
      </div>
    </div>

    <figure class="portrait">
      <div class="frame">
        <img src="/avatar.jpg" width="540" height="540" alt={`${site.name} giving a talk`} />
      </div>
      <figcaption class="bars">
        {
          skillBars.map((label, b) => (
            <div class="skill">
              <span class="pixel skill-label">{label}</span>
              <span class="pips" data-bar={b} role="img" aria-label={`${label}: max level`}>
                {Array.from({ length: PIPS }, (_, i) => (
                  <span class="pip on" style={`--i:${i}`} />
                ))}
              </span>
            </div>
          ))
        }
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100dvh - 64px);
    display: flex;
    align-items: center;
    padding: 48px 0 72px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .player {
    color: var(--accent);
    font-size: 14px;
    margin: 0 0 20px;
  }
  .name {
    font-weight: 400;
    font-size: clamp(40px, 6.4vw, 80px);
    line-height: 1.02;
    margin: 0 0 28px;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.45em;
  }
  .block {
    display: inline-block;
    animation: drop 640ms var(--ease) both;
    animation-delay: calc(120ms + var(--i) * 55ms);
  }
  @keyframes drop {
    0% {
      transform: translateY(-0.6em);
      opacity: 0;
    }
    60% {
      opacity: 1;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }
  .sub {
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--ink-2);
    max-width: 40ch;
    margin: 0 0 14px;
    animation: fade 700ms var(--ease) 900ms both;
  }
  .sub strong {
    color: var(--ink);
    font-weight: 600;
  }

  .typed {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 1.5em;
    margin: 0 0 36px;
    font-size: clamp(15px, 1.7vw, 20px);
    color: var(--ink);
    animation: fade 700ms var(--ease) 1000ms both;
  }
  .prompt {
    color: var(--accent);
  }
  .typed-text {
    white-space: pre;
  }
  .caret {
    width: 0.55em;
    height: 1.05em;
    margin-left: -6px;
    background: var(--accent);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    animation: fade 700ms var(--ease) 1100ms both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .portrait {
    margin: 0;
    justify-self: end;
    width: min(100%, 360px);
    animation: fade 900ms var(--ease) 600ms both;
  }
  .frame {
    aspect-ratio: 1;
    padding: 12px;
    background: var(--bg-2);
    border: 4px solid var(--ink);
    box-shadow:
      8px 8px 0 var(--accent-dim),
      inset 0 0 0 4px var(--bg);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bars {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }
  .skill {
    display: grid;
    gap: 6px;
  }
  .skill-label {
    font-size: 12px;
    color: var(--ink-2);
  }
  .pips {
    display: grid;
    grid-template-columns: repeat(20, 1fr);
    gap: 3px;
    transition: filter 300ms var(--ease);
  }
  .pip {
    height: 10px;
    background: var(--line);
  }
  .pip.on {
    background: var(--accent);
  }
  /* At the top of the bar: a glow and a light sweeping across it. */
  .pips.max {
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 65%, transparent));
  }
  .pips.max .pip {
    animation: shine 900ms step-end infinite;
    animation-delay: calc(var(--i) * 25ms);
  }
  @keyframes shine {
    0% {
      background: color-mix(in srgb, var(--accent) 45%, white);
    }
    14% {
      background: var(--accent);
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding: 40px 0 64px;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .portrait {
      justify-self: start;
      width: min(100%, 280px);
      order: -1;
    }
    .typed {
      min-height: 3em;
      align-items: flex-start;
    }
    .typed-text {
      white-space: normal;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../scripts/game';

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // Typed lines: type, hold, erase, next.
  const typed = document.querySelector<HTMLElement>('.typed')!;
  const text = typed.querySelector<HTMLElement>('.typed-text')!;
  const lines: string[] = JSON.parse(typed.dataset.lines!);

  async function typeLoop() {
    for (let n = 0; ; n = (n + 1) % lines.length) {
      const line = lines[n];
      for (let k = 1; k <= line.length; k++) {
        text.textContent = line.slice(0, k);
        await sleep(70);
      }
      await sleep(1900);
      for (let k = line.length - 1; k >= 0; k--) {
        text.textContent = line.slice(0, k);
        await sleep(28);
      }
      await sleep(350);
    }
  }

  // Skill bars: fill one pip at a time, glow at the top for three seconds,
  // drop to zero at once and start again.
  async function barLoop(bar: HTMLElement, startDelay: number) {
    const pips = [...bar.querySelectorAll<HTMLElement>('.pip')];
    await sleep(startDelay);
    for (;;) {
      bar.classList.remove('max');
      pips.forEach((p) => p.classList.remove('on'));
      await sleep(450);
      for (const p of pips) {
        p.classList.add('on');
        await sleep(90);
      }
      bar.classList.add('max');
      await sleep(3000);
    }
  }

  if (!prefersReducedMotion()) {
    text.textContent = '';
    typeLoop();
    document.querySelectorAll<HTMLElement>('.pips').forEach((bar, i) => barLoop(bar, 900 + i * 200));
  }
</script>
