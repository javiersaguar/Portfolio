---
import Sprite from './Sprite.astro';
import { certifications } from '../data/site';
---

<section class="section certs-section" id="certifications">
  <div class="wrap">
    <h2 class="section-title reveal">Certifications</h2>
    <ul class="certs">
      {
        certifications.map((c, i) => (
          <li class="cert reveal" style={`--d:${i + 1}`}>
            <Sprite name="medal" size={56} delay={i * 0.6} />
            <div>
              <p class="issuer mono">{c.issuer} · Certificate</p>
              <p class="cert-name">{c.name}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .certs-section {
    padding-top: 0;
  }
  .certs {
    list-style: none;
    padding: 0;
    margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .cert {
    display: flex;
    gap: 20px;
    align-items: center;
    padding: 22px 24px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    box-shadow: 6px 6px 0 var(--accent-dim);
  }
  .cert.in :global(.sprite) {
    animation: unlock 700ms var(--ease) both;
    animation-delay: calc(200ms + var(--d) * 120ms);
  }
  @keyframes unlock {
    0% {
      transform: scale(0.4) rotate(-12deg);
      opacity: 0;
    }
    70% {
      transform: scale(1.12);
      opacity: 1;
    }
  }
  .cert p {
    margin: 0;
  }
  .issuer {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 4px !important;
  }
  .cert-name {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (max-width: 767px) {
    .certs {
      grid-template-columns: 1fr;
    }
  }
</style>
