---
import { inventory, site } from '../data/site';

const stats = [
  { k: 'Data', v: 9 },
  { k: 'Security', v: 7 },
  { k: 'Backend', v: 7 },
  { k: 'Frontend', v: 5 },
];

const skills = ['Python', 'Scala', 'SQL', 'Spark', 'Kafka', 'Airflow', 'Docker', 'Kubernetes', 'TypeScript', 'FastAPI'];
---

<section class="section" id="about">
  <div class="wrap about">
    <div class="text reveal">
      <h2 class="section-title">About me</h2>
      <p>
        I'm {site.name}, a final-year {site.degree} student at {site.school} in Madrid. Most of my
        work lives where data meets infrastructure: pipelines that stream, store and serve, and the
        platforms around them.
      </p>
      <p>
        On the side I care about security. I build tools to audit what I deploy, and I like knowing how
        things break before someone else finds out.
      </p>
      <p>
        And sometimes I just build for fun: party games for my friends, a poker chip counter for nights
        without chips, and a whole Pokémon fangame.
      </p>
    </div>

    <aside class="sheet reveal" style="--d:2" aria-label="Character sheet">
      <header class="sheet-head">
        <span class="pixel">Player 1</span>
        <span class="pixel lvl">Lvl 4</span>
      </header>
      <div class="sheet-id">
        <img src="/avatar.png" width="64" height="64" alt="" />
        <div>
          <p class="pixel who">{site.name}</p>
          <p class="mono cls">Class: Data Engineer</p>
        </div>
      </div>

      <dl class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <dt class="mono">{s.k}</dt>
              <dd aria-label={`${s.v} out of 10`}>
                {Array.from({ length: 10 }, (_, i) => (
                  <span class:list={['pip', { on: i < s.v }]} style={`--p:${i}`} />
                ))}
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="label pixel">Inventory</p>
      <ul class="inv">
        {
          inventory.map((it) => (
            <li>
              <span class="pixel">{it.item}</span>
              <span class="mono">{it.value}</span>
            </li>
          ))
        }
      </ul>

      <p class="label pixel">Skills</p>
      <ul class="skills">
        {skills.map((s) => <li class="tag">{s}</li>)}
      </ul>

      <p class="label pixel">Special move</p>
      <p class="move">Give me a dataset and a weekend and I'll ship a pipeline around it.</p>
    </aside>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 64px;
    align-items: start;
  }
  .text p {
    color: var(--ink-2);
    font-size: 17px;
    max-width: 58ch;
    margin: 0 0 20px;
  }
  .text .section-title {
    margin-bottom: 28px;
  }

  .sheet {
    background: var(--bg-2);
    border: 4px solid var(--ink);
    box-shadow: 8px 8px 0 var(--accent-dim);
    padding: 24px;
  }
  .sheet-head {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: var(--muted);
    padding-bottom: 16px;
    border-bottom: 2px dashed var(--line);
  }
  .lvl {
    color: var(--accent);
  }
  .sheet-id {
    display: flex;
    gap: 16px;
    align-items: center;
    padding: 20px 0;
  }
  .sheet-id img {
    width: 56px;
    height: 56px;
    image-rendering: pixelated;
    border: 2px solid var(--ink);
  }
  .who {
    margin: 0;
    font-size: 20px;
  }
  .cls {
    margin: 2px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
  .stats {
    margin: 0 0 24px;
    display: grid;
    gap: 10px;
  }
  .stat {
    display: grid;
    grid-template-columns: 84px 1fr;
    align-items: center;
  }
  .stat dt {
    font-size: 12px;
    color: var(--muted);
  }
  .stat dd {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 3px;
  }
  .pip {
    height: 12px;
    background: var(--line);
  }
  .pip.on {
    background: var(--accent);
  }
  .sheet.in .pip.on {
    animation: pip 300ms var(--ease) both;
    animation-delay: calc(300ms + var(--p) * 60ms);
  }
  @keyframes pip {
    from {
      background: var(--line);
    }
  }
  .label {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 10px;
  }
  .inv {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .inv li {
    display: flex;
    flex-direction: column;
    padding: 8px 10px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .inv .pixel {
    font-size: 13px;
  }
  .inv .mono {
    font-size: 12px;
    color: var(--accent);
  }
  .skills {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .move {
    margin: 0;
    color: var(--ink);
    font-size: 15px;
  }

  @media (max-width: 1023px) {
    .about {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .sheet {
      max-width: 460px;
    }
  }
  @media (max-width: 767px) {
    .sheet {
      padding: 18px;
      box-shadow: 6px 6px 0 var(--accent-dim);
    }
  }
</style>
