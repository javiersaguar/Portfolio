---
import { stack } from '../data/site';
import { brandIcons } from '../data/brand-icons';

const total = stack.reduce((n, g) => n + g.items.length, 0);
const first = stack[0].items[0];
let index = 0;

// "text:RP" items have no logo: they show their letters in the pixel font, like the README.
const textOf = (icon: string) => (icon.startsWith('text:') ? icon.slice(5) : null);
---

<section class="section" id="stack">
  <div class="wrap">
    <h2 class="section-title reveal">Tech stack</h2>
    <p class="section-lead reveal">
      An inventory, not a badge wall. Hover an item or move with the arrow keys to see where I used it.
    </p>

    <div class="inventory reveal">
      <div class="inv-head">
        <span class="pixel inv-title">Inventory</span>
        <span class="inv-right">
          <span class="mono inv-hud" aria-hidden="true">{stack[0].group} / {first.name}</span>
          <span class="mono inv-count">{total} items</span>
        </span>
      </div>

      <div class="rows">
        {
          stack.map((g, r) => (
            <div class="row">
              <span class="group pixel">{g.group}</span>
              <ul class="slots" aria-label={g.group}>
                {g.items.map((it, c) => {
                  const i = index++;
                  const txt = textOf(it.icon);
                  return (
                    <li>
                      <button
                        type="button"
                        class:list={['slot', { sel: i === 0 }]}
                        style={`--i:${i}`}
                        tabindex={i === 0 ? 0 : -1}
                        data-i={i}
                        data-row={r}
                        data-col={c}
                        data-name={it.name}
                        data-group={g.group}
                        data-used={it.used}
                        aria-label={`${it.name}: ${it.used}`}
                      >
                        {txt ? (
                          <span class:list={['glyph', 'txt', 'pixel', { long: txt.length > 3 }]} aria-hidden="true">
                            {txt}
                          </span>
                        ) : (
                          <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true">
                            <path d={brandIcons[it.icon]} />
                          </svg>
                        )}
                        <span class="slot-name">{it.name}</span>
                      </button>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
        <span class="cursor" aria-hidden="true"></span>
      </div>

      <div class="desc" aria-live="polite">
        <span class="desc-icon" aria-hidden="true">
          <svg class="glyph" viewBox="0 0 24 24"><path d={brandIcons[first.icon]} /></svg>
        </span>
        <div class="desc-body">
          <p class="desc-name pixel">{first.name} <span class="desc-group mono">{stack[0].group}</span></p>
          <p class="desc-used">{first.used}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .inventory {
    background: var(--bg);
    border: 2px solid var(--line);
    box-shadow: 8px 8px 0 var(--accent-dim);
    padding: 24px 28px 28px;
  }
  .inv-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 22px;
  }
  .inv-title {
    color: var(--accent);
    font-size: 16px;
  }
  .inv-right {
    display: flex;
    gap: 18px;
    align-items: baseline;
  }
  .inv-hud {
    color: var(--accent);
    font-size: 13px;
  }
  .inv-count {
    color: var(--muted);
    font-size: 13px;
  }
  .rows {
    position: relative;
    display: grid;
    gap: 12px;
  }
  .row {
    display: grid;
    grid-template-columns: 96px 1fr;
    align-items: center;
    gap: 14px;
  }
  .group {
    font-size: 13px;
    color: var(--ink-2);
  }
  .slots {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .slot {
    position: relative;
    width: 70px;
    height: 66px;
    display: grid;
    grid-template-rows: 30px auto;
    place-items: center;
    align-content: center;
    gap: 6px;
    padding: 0 2px;
    color: var(--ink-2);
    background: var(--bg-2);
    border: 1px solid var(--line);
    cursor: pointer;
    transition:
      color 120ms ease,
      background-color 120ms ease;
  }
  /* Slots pop in row by row the first time the inventory is seen. */
  .inventory.reveal .slot {
    opacity: 0;
  }
  .inventory.reveal.in .slot {
    animation: slot-in 320ms var(--ease) both;
    animation-delay: calc(200ms + var(--i) * 12ms);
  }
  @keyframes slot-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .glyph {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }
  .txt {
    display: grid;
    place-items: center;
    width: auto;
    font-size: 15px;
    line-height: 1;
    letter-spacing: 0;
  }
  .txt.long {
    font-size: 11px;
  }
  .slot-name {
    font-size: 10.5px;
    line-height: 1.1;
    text-align: center;
    color: var(--muted);
  }
  .slot:focus-visible {
    outline: none;
  }
  .slot.sel {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 9%, var(--bg-2));
  }

  /* One set of pixel corner brackets that glides to the selected slot. */
  .cursor {
    position: absolute;
    left: 0;
    top: 0;
    width: 70px;
    height: 66px;
    pointer-events: none;
    opacity: 0;
    --c: var(--accent);
    background:
      linear-gradient(var(--c), var(--c)) top left / 12px 3px,
      linear-gradient(var(--c), var(--c)) top left / 3px 12px,
      linear-gradient(var(--c), var(--c)) top right / 12px 3px,
      linear-gradient(var(--c), var(--c)) top right / 3px 12px,
      linear-gradient(var(--c), var(--c)) bottom left / 12px 3px,
      linear-gradient(var(--c), var(--c)) bottom left / 3px 12px,
      linear-gradient(var(--c), var(--c)) bottom right / 12px 3px,
      linear-gradient(var(--c), var(--c)) bottom right / 3px 12px;
    background-repeat: no-repeat;
    margin: -6px 0 0 -6px;
    padding: 6px;
    box-sizing: content-box;
    transition:
      transform 200ms var(--ease-in-out),
      opacity 200ms ease;
  }
  .cursor.ready {
    opacity: 1;
  }
  .cursor.far {
    /* Jumping to another row: a slightly longer glide reads better than a snap. */
    transition-duration: 280ms;
  }

  .desc {
    display: flex;
    gap: 18px;
    align-items: center;
    margin-top: 24px;
    padding: 16px 20px;
    min-height: 88px;
    background: var(--bg-2);
    border: 2px dashed var(--line);
  }
  .desc-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    color: var(--accent);
  }
  .desc-icon :global(.glyph) {
    width: 40px;
    height: 40px;
  }
  .desc-icon :global(.txt) {
    font-size: 22px;
  }
  .desc-icon :global(.txt.long) {
    font-size: 15px;
  }
  .desc p {
    margin: 0;
  }
  .desc-name {
    font-size: 18px;
    margin-bottom: 4px !important;
  }
  .desc-group {
    font-size: 12px;
    color: var(--muted);
    margin-left: 8px;
  }
  .desc-used {
    color: var(--ink-2);
    font-size: 15px;
  }

  @media (max-width: 767px) {
    .inventory {
      padding: 18px;
      box-shadow: 6px 6px 0 var(--accent-dim);
    }
    .inv-hud {
      display: none;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .slot,
    .cursor {
      width: 64px;
      height: 62px;
    }
    .slot-name {
      font-size: 10px;
    }
  }
</style>

<script>
  import { prefersReducedMotion, unlock } from '../scripts/game';

  const root = document.querySelector<HTMLElement>('#stack .inventory')!;
  const rows = root.querySelector<HTMLElement>('.rows')!;
  const slots = [...root.querySelectorAll<HTMLButtonElement>('.slot')];
  const cursor = root.querySelector<HTMLElement>('.cursor')!;
  const hud = root.querySelector<HTMLElement>('.inv-hud')!;
  const descIcon = root.querySelector<HTMLElement>('.desc-icon')!;
  const descBody = root.querySelector<HTMLElement>('.desc-body')!;
  const name = root.querySelector<HTMLElement>('.desc-name')!;
  const used = root.querySelector<HTMLElement>('.desc-used')!;
  let current = 0;

  const place = (far = false) => {
    // offsetLeft/Top are relative to .rows (the nearest positioned box) and ignore
    // the slots' own entrance transforms.
    const s = slots[current];
    cursor.classList.toggle('far', far);
    cursor.style.transform = `translate(${s.offsetLeft}px, ${s.offsetTop}px)`;
  };

  const select = (i: number, focus = false) => {
    if (i === current) return;
    const far = slots[i].dataset.row !== slots[current].dataset.row;
    slots[current].classList.remove('sel');
    slots[current].tabIndex = -1;
    current = i;
    const s = slots[i];
    s.classList.add('sel');
    s.tabIndex = 0;
    if (focus) s.focus();
    place(far);
    hud.textContent = `${s.dataset.group} / ${s.dataset.name}`;
    descIcon.replaceChildren(s.querySelector('.glyph')!.cloneNode(true));
    name.firstChild!.textContent = `${s.dataset.name} `;
    name.querySelector('.desc-group')!.textContent = s.dataset.group!;
    used.textContent = s.dataset.used!;
    if (!prefersReducedMotion()) {
      descBody.animate(
        { opacity: [0, 1], transform: ['translateY(4px)', 'none'] },
        { duration: 160, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
      );
    }
  };

  // The cursor shows up once the slots have popped in, then follows the selection.
  const showCursor = () => {
    place();
    requestAnimationFrame(() => cursor.classList.add('ready'));
  };
  if (prefersReducedMotion() || root.classList.contains('in')) showCursor();
  else {
    const seen = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        seen.disconnect();
        setTimeout(showCursor, 500);
      }
    });
    seen.observe(root);
  }
  // Layout changes (resize, fonts) move the slots: put the cursor back without gliding.
  new ResizeObserver(() => {
    cursor.style.transition = 'none';
    place();
    void cursor.offsetWidth;
    cursor.style.transition = '';
  }).observe(rows);

  // Until someone touches it, the cursor walks the inventory by itself.
  let auto: number | undefined;
  const stopAuto = () => {
    if (auto !== undefined) clearInterval(auto);
    auto = undefined;
  };
  const byUser = (i: number, focus = false) => {
    stopAuto();
    root.dataset.touched = '1';
    select(i, focus);
    unlock('inventory');
  };

  slots.forEach((s, i) => {
    s.addEventListener('pointerenter', () => byUser(i));
    s.addEventListener('click', () => byUser(i));
    s.addEventListener('focus', () => {
      if (current !== i) byUser(i);
    });
  });

  // Arrow keys: left and right through the list, up and down between rows.
  root.addEventListener('keydown', (e) => {
    const s = slots[current];
    const row = Number(s.dataset.row);
    const col = Number(s.dataset.col);
    const inRow = (r: number) => slots.filter((x) => Number(x.dataset.row) === r);
    let next: number | undefined;
    if (e.key === 'ArrowRight') next = Math.min(slots.length - 1, current + 1);
    else if (e.key === 'ArrowLeft') next = Math.max(0, current - 1);
    else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      const target = inRow(row + (e.key === 'ArrowDown' ? 1 : -1));
      if (target.length) next = Number(target[Math.min(col, target.length - 1)].dataset.i);
    } else if (e.key === 'Home') next = 0;
    else if (e.key === 'End') next = slots.length - 1;
    if (next !== undefined) {
      e.preventDefault();
      byUser(next, true);
    }
  });

  if (!prefersReducedMotion()) {
    const io = new IntersectionObserver((entries) => {
      const visible = entries.some((e) => e.isIntersecting);
      if (visible && auto === undefined && !root.dataset.touched) {
        auto = window.setInterval(() => select((current + 1) % slots.length), 1400);
      } else if (!visible) stopAuto();
    });
    io.observe(root);
  }
</script>
