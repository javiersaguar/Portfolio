---
interface Props { frames: readonly (readonly string[])[]; class?: string; }
const { frames, class: className } = Astro.props;
const height = frames[0].length;
const width = frames[0][0].length;
const runs = (rows: readonly string[]) => rows.flatMap((row, y) => {
  const result: { x: number; y: number; width: number; color: string }[] = [];
  let x = 0;
  while (x < row.length) {
    const color = row[x];
    const start = x++;
    while (x < row.length && row[x] === color) x++;
    if (color !== '.') result.push({ x: start, y, width: x - start, color });
  }
  return result;
});
---
<svg class:list={['arcade-sprite', className]} viewBox={`0 0 ${width} ${height}`} shape-rendering="crispEdges" aria-hidden="true">
  {frames.map((frame, index) => <g class:list={['sprite-frame', { 'sprite-frame-alt': index === 1 }]}>{runs(frame).map(pixel => <rect x={pixel.x} y={pixel.y} width={pixel.width} height="1" class={`color-${pixel.color}`} />)}</g>)}
</svg>
<style>
  .arcade-sprite { width: 100%; height: 100%; display: block; overflow: visible; }
  .color-g { fill: var(--accent); } .color-d { fill: var(--accent-dim); } .color-w { fill: var(--ink); } .color-m { fill: var(--muted); } .color-k { fill: var(--line); }
  .sprite-frame-alt { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .sprite-frame:has(+ .sprite-frame-alt) { animation: frame-a 1.6s step-end infinite; animation-delay: var(--sprite-delay, 0s); }
    .sprite-frame-alt { display: block; opacity: 0; animation: frame-b 1.6s step-end infinite; animation-delay: var(--sprite-delay, 0s); }
    @keyframes frame-a { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    @keyframes frame-b { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  }
</style>
