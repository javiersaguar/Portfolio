---
import Icon from './Icon.astro';
import Sprite from './Sprite.astro';
import { categories, coursework, featured, sideQuests, site } from '../data/site';

// Three wide cards in a zigzag fill a three-column grid without gaps.
const wide = new Set([0, 3, 4]);
const count = (id: string) => (id === 'all' ? featured.length : featured.filter((p) => p.tags.includes(id as never)).length);
---

<section class="section" id="projects">
  <div class="wrap">
    <h2 class="section-title reveal">Projects</h2>
    <p class="section-lead reveal">
      Data platforms, security tooling and a game. Built at hackathons, for class, and on weekends.
    </p>

    <div class="filters reveal" role="group" aria-label="Filter projects">
      {
        categories.map((c, i) => (
          <button type="button" class="filter pixel" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {c.label} <span class="count mono">{count(c.id)}</span>
          </button>
        ))
      }
    </div>

    <div class="grid">
      {
        featured.map((p, i) => (
          <article class:list={['card', 'reveal', { big: wide.has(i) }]} data-tags={p.tags.join(' ')} style={`--d:${i % 3}`}>
            <div class="card-top">
              <div class="who">
                <Sprite name={p.sprite} size={wide.has(i) ? 56 : 44} delay={i * 0.2} />
                <span class="context mono">{p.context}</span>
              </div>
              <div class="stat">
                <span class="stat-value pixel">{p.stat.value}</span>
                <span class="stat-label">{p.stat.label}</span>
              </div>
            </div>
            <h3 class="pixel">{p.name}</h3>
            <p class="tagline">{p.tagline}</p>
            <p class="body">{p.body}</p>
            <ul class="stack" aria-label="Stack">
              {p.stack.map((s) => (
                <li class="tag">{s}</li>
              ))}
            </ul>
            <div class="actions">
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener" class="link live">
                  <Icon name="play" /> Live demo
                </a>
              )}
              <a href={`${site.github}/${p.repo}`} target="_blank" rel="noopener" class="link">
                <Icon name="github" /> Code
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="none mono" hidden>Nothing here yet.</p>

    <h3 class="sub-title pixel reveal">Side quests</h3>
    <p class="sub-lead reveal">Small things I made for game nights. All of them are live.</p>
    <ul class="quests">
      {
        sideQuests.map((q, i) => (
          <li class="reveal" style={`--d:${i}`}>
            <a href={q.url} target="_blank" rel="noopener" class="quest">
              <Sprite name={q.sprite} size={44} delay={i * 0.3} />
              <span class="q-body">
                <span class="q-tag mono">Side quest</span>
                <span class="q-name pixel">{q.name}</span>
                <span class="q-note">{q.note}</span>
              </span>
              <span class="q-play pixel">
                Play <Icon name="play" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="class-panel reveal">
      <p class="class-title pixel">Also built for class</p>
      <ul class="class-list">
        {
          coursework.map((c, i) => (
            <li>
              <Sprite name={c.sprite} size={44} delay={i * 0.4} />
              <div>
                <p class="c-name pixel">{c.name}</p>
                <p class="c-note">{c.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: -16px 0 32px;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: 14px;
    color: var(--ink-2);
    background: var(--bg-2);
    border: 1px solid var(--line);
    cursor: pointer;
    transition:
      color 160ms var(--ease),
      border-color 160ms var(--ease),
      transform 160ms var(--ease),
      box-shadow 160ms var(--ease);
  }
  .filter:hover {
    color: var(--ink);
    border-color: var(--accent-dim);
  }
  .filter[aria-pressed='true'] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 3px 3px 0 var(--accent-dim);
  }
  .count {
    font-size: 11px;
    opacity: 0.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    transition:
      border-color 200ms var(--ease),
      transform 200ms var(--ease),
      box-shadow 200ms var(--ease),
      opacity 600ms var(--ease);
  }
  .card:hover {
    border-color: var(--accent-dim);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--accent-dim);
  }
  .card[hidden] {
    display: none;
  }
  .card.big {
    grid-column: span 2;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 55%),
      repeating-linear-gradient(0deg, transparent 0 15px, color-mix(in srgb, var(--accent) 5%, transparent) 15px 16px),
      var(--bg-2);
  }
  .grid.filtered .card.big {
    grid-column: auto;
  }
  .grid.filtered .card {
    animation: pop-in 320ms var(--ease) both;
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
  }
  .who {
    display: grid;
    gap: 14px;
  }
  .context {
    font-size: 12px;
    color: var(--muted);
  }
  .stat {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .stat-value {
    font-size: 30px;
    line-height: 1;
    color: var(--accent);
  }
  .big .stat-value {
    font-size: 52px;
  }
  .stat-label {
    font-size: 12px;
    color: var(--muted);
    max-width: 18ch;
    margin-top: 6px;
  }
  h3 {
    font-weight: 400;
    font-size: 24px;
    line-height: 1.15;
    margin: 0 0 6px;
  }
  .big h3 {
    font-size: 34px;
  }
  .tagline {
    margin: 0 0 12px;
    color: var(--ink);
    font-weight: 500;
  }
  .body {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 15px;
  }
  .big .body {
    max-width: 62ch;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .actions {
    margin-top: auto;
    display: flex;
    gap: 20px;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-pixel);
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 160ms var(--ease);
  }
  .link:hover,
  .link.live {
    color: var(--accent);
  }
  .link :global(.icon) {
    width: 16px;
    height: 16px;
  }
  .none {
    color: var(--muted);
  }

  .sub-title {
    font-weight: 400;
    font-size: 24px;
    margin: 88px 0 6px;
  }
  .sub-lead {
    color: var(--muted);
    margin: 0 0 24px;
  }
  .quests {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .quest {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 18px 20px;
    text-decoration: none;
    background: var(--bg-2);
    border: 1px solid var(--line);
    transition:
      border-color 200ms var(--ease),
      transform 200ms var(--ease),
      box-shadow 200ms var(--ease);
  }
  .quest:hover {
    border-color: var(--accent-dim);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--accent-dim);
  }
  .q-body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .q-tag {
    font-size: 11px;
    color: var(--muted);
  }
  .q-name {
    font-size: 18px;
  }
  .q-note {
    color: var(--ink-2);
    font-size: 14px;
  }
  .q-play {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--accent);
  }
  .q-play :global(.icon) {
    width: 14px;
    height: 14px;
  }
  .quest:hover .q-play {
    animation: blink 0.8s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .class-panel {
    margin-top: 40px;
    padding: 24px 28px 28px;
    border: 1px dashed var(--line);
  }
  .class-title {
    margin: 0 0 20px;
    font-size: 14px;
    color: var(--accent);
  }
  .class-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .class-list li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .c-name {
    margin: 0 0 4px;
    font-size: 16px;
  }
  .c-note {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card.big {
      grid-column: auto;
    }
    .class-list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .grid,
    .quests {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 22px;
    }
    .big .stat-value {
      font-size: 40px;
    }
    .quest {
      grid-template-columns: auto 1fr;
    }
    .q-play {
      grid-column: 2;
    }
  }
</style>

<script>
  import { unlock } from '../scripts/game';

  const grid = document.querySelector<HTMLElement>('#projects .grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
  const none = document.querySelector<HTMLElement>('#projects .none')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#projects .filter')];

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const id = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      for (const card of cards) {
        const match = id === 'all' || card.dataset.tags!.split(' ').includes(id);
        card.hidden = !match;
        card.classList.add('in');
        if (match) shown++;
      }
      // Restart the pop-in on every change.
      grid.classList.remove('filtered');
      void grid.offsetWidth;
      grid.classList.toggle('filtered', id !== 'all');
      none.hidden = shown > 0;
      if (id !== 'all') unlock('filter');
    }),
  );
</script>
