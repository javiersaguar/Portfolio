---
import Icon from './Icon.astro';
import Sprite from './Sprite.astro';
import { getContent, getLocale, translate } from '../data/i18n';
const locale = getLocale(Astro.url);
const t = (text: string) => translate(locale, text);
const { categories, coursework, featured, sideQuests, site } = getContent(locale);

// Dos fichas anchas y cinco normales completan una cuadrícula de nueve celdas.
const wide = new Set([0, 3]);
const count = (id: string) => (id === 'all' ? featured.length : featured.filter((p) => p.tags.includes(id as never)).length);
---

<section class="section" id="projects">
  <div class="wrap">
    <h2 class="section-title reveal">{t("Projects")}</h2>
    <p class="section-lead reveal">{t("Data platforms, security tooling and a game. Built at hackathons, for class, and on weekends.")}</p>

    <div class="filters reveal" role="group" aria-label={t("Filter projects")}>
      {
        categories.map((c, i) => (
          <button type="button" class="filter pixel" data-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {c.label} <span class="count mono">{count(c.id)}</span>
          </button>
        ))
      }
    </div>

    <div class="grid">
      {
        featured.map((p, i) => (
          <article
            class:list={['card', 'reveal', { big: wide.has(i) }]}
            data-tags={p.tags.join(' ')}
            style={`--d:${i % 3}`}
          >
            <span class="scan" aria-hidden="true" />
            <div class="card-top">
              <div class="who">
                <Sprite name={p.sprite} size={wide.has(i) ? 56 : 44} delay={i * 0.2} />
                <span class="context mono">{p.context}</span>
              </div>
              <div class="stat">
                <span class="stat-value pixel" data-count style={`min-width:${p.stat.value.length}ch`}>
                  {p.stat.value}
                </span>
                <span class="stat-label">{p.stat.label}</span>
              </div>
            </div>
            <h3 class="pixel">{p.name}</h3>
            <p class="tagline">{p.tagline}</p>
            <p class="body">{p.body}</p>
            <ul class="stack" aria-label={t("Stack")}>
              {p.stack.map((s, t) => (
                <li class="tag" style={`--t:${t}`}>
                  {s}
                </li>
              ))}
            </ul>
            <div class="actions">
              {p.url && (
                <a href={p.url} target="_blank" rel="noopener" class="link live">
                  <Icon name="play" />{t("Live demo")}</a>
              )}
              <a href={`${site.github}/${p.repo}`} target="_blank" rel="noopener" class="link">
                <Icon name="github" />{t("Code")}<Icon name="arrow" class="arrow" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
    <p class="none mono" hidden>{t("Nothing here yet.")}</p>

    <h3 class="sub-title pixel reveal">{t("Side quests")}</h3>
    <p class="sub-lead reveal">{t("Small things I made for game nights. All of them are live.")}</p>
    <ul class="quests">
      {
        sideQuests.map((q, i) => (
          <li class="reveal" style={`--d:${i}`}>
            <a href={q.url} target="_blank" rel="noopener" class="quest">
              <Sprite name={q.sprite} size={44} delay={i * 0.3} />
              <span class="q-body">
                <span class="q-tag mono">{t("Side quest")}</span>
                <span class="q-name pixel">{q.name}</span>
                <span class="q-note">{q.note}</span>
              </span>
              <span class="q-play pixel">{t("Play")}<Icon name="play" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="class-panel reveal">
      <p class="class-title pixel">{t("Also built for class")}</p>
      <ul class="class-list">
        {
          coursework.map((c, i) => (
            <li class="hop" style={`--c:${i}`}>
              <Sprite name={c.sprite} size={44} delay={i * 0.4} />
              <div>
                <p class="c-name pixel">{c.name}</p>
                <p class="c-note">{c.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: -16px 0 32px;
  }
  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    font-size: 14px;
    color: var(--ink-2);
    background: var(--bg-2);
    border: 1px solid var(--line);
    cursor: pointer;
    transition:
      color 160ms var(--ease),
      border-color 160ms var(--ease),
      transform 160ms var(--ease),
      box-shadow 160ms var(--ease);
  }
  .filter:hover {
    color: var(--ink);
    border-color: var(--accent-dim);
  }
  .filter[aria-pressed='true'] {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 3px 3px 0 var(--accent-dim);
  }
  .count {
    font-size: 11px;
    opacity: 0.7;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    transition:
      border-color 200ms var(--ease),
      transform 200ms var(--ease),
      box-shadow 200ms var(--ease),
      opacity 600ms var(--ease);
  }
  .card {
    isolation: isolate;
    overflow: hidden;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      border-color: var(--accent-dim);
      transform: translate(-3px, -3px);
      box-shadow: 6px 6px 0 var(--accent-dim);
    }
    .card:hover::before {
      opacity: 1;
    }
    .card:hover .stack .tag {
      border-color: var(--accent-dim);
    }
    .link:hover :global(.arrow) {
      transform: translate(2px, -2px);
    }
  }
  /* Light that follows the pointer over the card (--mx/--my set by the script). */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      260px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in srgb, var(--accent) 13%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 240ms ease;
  }
  /* Entrance, once: the card rises, a scan line sweeps it like an old screen
     turning on, then the stack tags drop in one by one. */
  .card.reveal.in {
    animation: card-in 640ms var(--ease) backwards;
    animation-delay: calc(var(--d) * 90ms);
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.97);
    }
  }
  .scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 35%;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      transparent,
      color-mix(in srgb, var(--accent) 14%, transparent) 80%,
      color-mix(in srgb, var(--accent) 45%, transparent) 98%,
      transparent
    );
    opacity: 0;
  }
  .card.in .scan {
    animation: scan 1000ms var(--ease-in-out) both;
    animation-delay: calc(180ms + var(--d) * 90ms);
  }
  @keyframes scan {
    0% {
      opacity: 1;
      transform: translateY(-100%);
    }
    85% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(300%);
    }
  }
  .card.in .stack .tag {
    animation: tag-in 300ms var(--ease) backwards;
    animation-delay: calc(420ms + var(--d) * 90ms + var(--t) * 45ms);
  }
  @keyframes tag-in {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
  }
  .stack .tag {
    transition: border-color 200ms ease;
  }
  .link :global(.arrow) {
    width: 12px;
    height: 12px;
    transition: transform 160ms var(--ease);
  }
  .card[hidden] {
    display: none;
  }
  .card.big {
    grid-column: span 2;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 55%),
      repeating-linear-gradient(0deg, transparent 0 15px, color-mix(in srgb, var(--accent) 5%, transparent) 15px 16px),
      var(--bg-2);
  }
  .grid.narrow .card.big {
    grid-column: auto;
  }
  .grid.filtered .card {
    animation: pop-in 320ms var(--ease) backwards;
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 24px;
  }
  .who {
    display: grid;
    gap: 14px;
  }
  .context {
    font-size: 12px;
    color: var(--muted);
  }
  .stat {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }
  .stat-value {
    font-size: 30px;
    line-height: 1;
    color: var(--accent);
  }
  .big .stat-value {
    font-size: 52px;
  }
  .stat-label {
    font-size: 12px;
    color: var(--muted);
    max-width: 18ch;
    margin-top: 6px;
  }
  h3 {
    font-weight: 400;
    font-size: 24px;
    line-height: 1.15;
    margin: 0 0 6px;
  }
  .big h3 {
    font-size: 34px;
  }
  .tagline {
    margin: 0 0 12px;
    color: var(--ink);
    font-weight: 500;
  }
  .body {
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 15px;
  }
  .big .body {
    max-width: 62ch;
  }
  .stack {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .actions {
    margin-top: auto;
    display: flex;
    gap: 20px;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-pixel);
    font-size: 14px;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 160ms var(--ease);
  }
  .link:hover,
  .link.live {
    color: var(--accent);
  }
  .link :global(.icon) {
    width: 16px;
    height: 16px;
  }
  .none {
    color: var(--muted);
  }

  .sub-title {
    font-weight: 400;
    font-size: 24px;
    margin: 88px 0 6px;
  }
  .sub-lead {
    color: var(--muted);
    margin: 0 0 24px;
  }
  .quests {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .quest {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 18px 20px;
    text-decoration: none;
    background: var(--bg-2);
    border: 1px solid var(--line);
    transition:
      border-color 200ms var(--ease),
      transform 200ms var(--ease),
      box-shadow 200ms var(--ease);
  }
  .quest:hover {
    border-color: var(--accent-dim);
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--accent-dim);
  }
  .q-body {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .q-tag {
    font-size: 11px;
    color: var(--muted);
  }
  .q-name {
    font-size: 18px;
  }
  .q-note {
    color: var(--ink-2);
    font-size: 14px;
  }
  .q-play {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--accent);
  }
  .q-play :global(.icon) {
    width: 14px;
    height: 14px;
  }
  @media (hover: hover) and (pointer: fine) {
    .quest:hover .q-play {
      animation: blink 0.8s step-end infinite;
    }
    .quest:hover .q-play :global(.icon) {
      transform: translateX(3px);
    }
  }
  .q-play :global(.icon) {
    transition: transform 160ms var(--ease);
  }
  .class-panel.in li {
    animation: tag-in 420ms var(--ease) backwards;
    animation-delay: calc(200ms + var(--c) * 90ms);
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .class-panel {
    margin-top: 40px;
    padding: 24px 28px 28px;
    border: 1px dashed var(--line);
  }
  .class-title {
    margin: 0 0 20px;
    font-size: 14px;
    color: var(--accent);
  }
  .class-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .class-list li {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .c-name {
    margin: 0 0 4px;
    font-size: 16px;
  }
  .c-note {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 1023px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .card.big {
      grid-column: auto;
    }
    .class-list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 767px) {
    .grid,
    .quests {
      grid-template-columns: 1fr;
    }
    .card {
      padding: 22px;
    }
    .big .stat-value {
      font-size: 40px;
    }
    .quest {
      grid-template-columns: auto 1fr;
    }
    .q-play {
      grid-column: 2;
    }
  }
</style>

<script>
  import { prefersReducedMotion, unlock } from '../scripts/game';

  const grid = document.querySelector<HTMLElement>('#projects .grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.card')];
  const none = document.querySelector<HTMLElement>('#projects .none')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#projects .filter')];

  type VTDocument = Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };

  const apply = (id: string) => {
    let shown = 0;
    for (const card of cards) {
      const match = id === 'all' || card.dataset.tags!.split(' ').includes(id);
      card.hidden = !match;
      card.classList.add('in');
      if (match) shown++;
    }
    grid.classList.toggle('narrow', id !== 'all');
    none.hidden = shown > 0;
  };

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const id = btn.dataset.filter!;
      if (btn.getAttribute('aria-pressed') === 'true') return;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      const doc = document as VTDocument;
      if (doc.startViewTransition && !prefersReducedMotion()) {
        // Cards glide from their old place to the new one; leaving cards shrink
        // and fade, arriving ones grow in. Names are only set for this transition,
        // so the theme switch keeps its single circle.
        cards.forEach((c, i) => (c.style.viewTransitionName = `card-${i}`));
        const vt = doc.startViewTransition(() => apply(id));
        vt.finished.finally(() => cards.forEach((c) => (c.style.viewTransitionName = '')));
      } else {
        apply(id);
        // Older browsers: restart a short pop-in instead.
        grid.classList.remove('filtered');
        void grid.offsetWidth;
        grid.classList.toggle('filtered', id !== 'all');
      }
      if (id !== 'all') unlock('filter');
    }),
  );

  // Pointer light. Only with a real mouse; the position is set on each card itself.
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    for (const card of cards) {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    }
  }
</script>
