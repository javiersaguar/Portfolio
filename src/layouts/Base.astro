---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · Data Engineer`,
  description = 'Final-year Data Engineering student at ETSIT UPM. Big Data projects, cybersecurity audits, and apps, tools and games built end to end.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d0b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        if (localStorage.getItem('js-palette') === 'gb') document.documentElement.dataset.palette = 'gb';
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { toast, toggleGameBoy, unlock } from '../scripts/game';

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Reaching the footer counts as exploring the whole page.
      const foot = document.querySelector('.foot');
      if (foot) {
        const end = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            unlock('explorer');
            end.disconnect();
          }
        });
        end.observe(foot);
      }

      // Konami code: Game Boy palette.
      const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
      let pos = 0;
      addEventListener('keydown', (e) => {
        const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
        pos = key === code[pos] ? pos + 1 : key === code[0] ? 1 : 0;
        if (pos === code.length) {
          pos = 0;
          toast('Cheat code', toggleGameBoy() ? 'Game Boy mode on' : 'Game Boy mode off');
          unlock('konami');
        }
      });
    </script>
  </body>
</html>
