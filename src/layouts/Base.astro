---
import '../styles/global.css';
import { site } from '../data/site';
import { getLocale, translate } from '../data/i18n';
import { arcadeCopy } from '../data/arcade-copy';

const locale = getLocale(Astro.url);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} · ${arcadeCopy(locale).role}`,
  description = translate(locale, 'Final-year Data Engineering student at ETSIT UPM. Big Data projects, cybersecurity audits, and apps, tools and games built end to end.'),
} = Astro.props;
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-Hans' : locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d0b" />
    <meta name="color-scheme" content="dark light" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      try {
        if (localStorage.getItem('js-palette') === 'gb') document.documentElement.dataset.palette = 'gb';
        var t = localStorage.getItem('js-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        var language = localStorage.getItem('js-language');
        if (location.pathname === '/' && (language === 'es' || language === 'zh')) {
          location.replace('/' + language + '/' + location.search + location.hash);
        }
      } catch (e) {}
      var section = location.hash.slice(1);
      var isSection = ['top', 'projects', 'about', 'education', 'experience', 'skills', 'stack', 'certifications', 'activity', 'contact'].indexOf(section) !== -1;
      document.documentElement.dataset.view = isSection ? 'portfolio' : 'arcade';
      document.documentElement.dataset.section = isSection ? section : 'top';
      var hasSeenIntro = false;
      try { hasSeenIntro = sessionStorage.getItem('js-intro-seen-native-v1') === 'yes'; } catch (e) {}
      document.documentElement.dataset.intro = !isSection && !hasSeenIntro && !matchMedia('(prefers-reduced-motion: reduce)').matches ? 'pending' : 'done';
    </script>
  </head>
  <body>
    <slot />
    <script>
      import { prefersReducedMotion, toast, toggleGameBoy, unlock } from '../scripts/game';
      import { syncThemeColor } from '../scripts/theme';
      import { getLocale, translate } from '../data/i18n';
      const locale = getLocale(location.href);

      syncThemeColor();
      document.addEventListener('palette', syncThemeColor);

      // Section titles drop in letter by letter, with a little jitter like the README.
      document.querySelectorAll<HTMLElement>('.section-title').forEach((h) => {
        if (h.children.length) return;
        const text = h.textContent!.trim();
        h.setAttribute('aria-label', text);
        h.textContent = '';
        [...text].forEach((c, i) => {
          const s = document.createElement('span');
          s.className = 'ch';
          s.setAttribute('aria-hidden', 'true');
          s.style.setProperty('--i', String(i));
          s.style.setProperty('--j', String(Math.round(Math.random() * 160)));
          s.textContent = c;
          h.append(s);
        });
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Numbers count up the first time they scroll into view: "540/540", "24.6M", "301,218".
      // Text that is not a number (GKE) is scrambled into place instead.
      const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
      const countUp = (el: HTMLElement) => {
        const final = el.textContent ?? '';
        const m = final.match(/^(\d[\d,]*(?:\.\d+)?)(.*)$/);
        const duration = 1100;
        const t0 = performance.now();
        const ease = (t: number) => 1 - Math.pow(1 - t, 4);
        const frame = (now: number) => {
          const t = Math.min(1, (now - t0) / duration);
          if (m) {
            const target = Number(m[1].replace(/,/g, ''));
            const decimals = (m[1].split('.')[1] ?? '').length;
            const value = target * ease(t);
            const text = m[1].includes(',')
              ? Math.round(value).toLocaleString('en-US')
              : value.toFixed(decimals);
            el.textContent = text + m[2];
          } else {
            const fixed = Math.floor(final.length * ease(t));
            el.textContent =
              final.slice(0, fixed) +
              [...final.slice(fixed)].map(() => GLYPHS[Math.floor(Math.random() * GLYPHS.length)]).join('');
          }
          if (t < 1) requestAnimationFrame(frame);
          else el.textContent = final;
        };
        requestAnimationFrame(frame);
      };
      if (!prefersReducedMotion()) {
        const counters = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              counters.unobserve(e.target);
              countUp(e.target as HTMLElement);
            }
          },
          { threshold: 0.6 },
        );
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => counters.observe(el));
      }

      // Reaching the footer counts as exploring the whole page.
      const foot = document.querySelector('.foot');
      if (foot) {
        const end = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            unlock('explorer');
            end.disconnect();
          }
        });
        end.observe(foot);
      }

      // Konami code: Game Boy palette.
      const code = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
      let pos = 0;
      addEventListener('keydown', (e) => {
        const key = e.key.length === 1 ? e.key.toLowerCase() : e.key;
        pos = key === code[pos] ? pos + 1 : key === code[0] ? 1 : 0;
        if (pos === code.length) {
          pos = 0;
          toast(translate(locale, 'Cheat code'), translate(locale, toggleGameBoy() ? 'Game Boy mode on' : 'Game Boy mode off'));
          unlock('konami');
        }
      });
    </script>
  </body>
</html>
